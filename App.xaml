<Application
    x:Class="RnxBluetoothDiagnost.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="WorkspaceBrush" Color="#111822"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#19232F"/>
            <SolidColorBrush x:Key="PanelEdgeBrush" Color="#334352"/>
            <SolidColorBrush x:Key="InsetBrush" Color="#141D27"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#BDCADD"/>
            <SolidColorBrush x:Key="AccentTextBrush" Color="#83E8D9"/>
            <SolidColorBrush x:Key="ActionBrush" Color="#9BEBDD"/>
            <SolidColorBrush x:Key="ActionTextBrush" Color="#102B2A"/>
            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20"/>
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{StaticResource ActionBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource ActionTextBrush}"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="14,5"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
